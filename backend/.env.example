# ===== LLM 配置（OpenAI 兼容接口）=====
# 推荐使用 DeepSeek（性价比高，中文追问质量好）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-你的deepseek key
#
# 或使用 OpenAI：
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#   LLM_API_KEY=sk-你的openai key

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-YOUR_API_KEY

# 生成温度
LLM_TEMPERATURE=0.7

# 服务端口
PORT=8000

# ===== 认证配置 =====
# JWT 签名密钥：留空则首次启动自动生成并持久化到 data/.jwt_secret（生产建议显式配置一个随机长字符串）
JWT_SECRET=
# 演示账户开关：true=播种 alice/bob/carol/dave（密码 pass123）并在登录页展示，仅本地演示用；上线必须改为 false
SEED_DEMO_ACCOUNTS=true

# ===== 代码沙箱配置 =====
# 判题执行模式：docker=强制容器隔离（生产必须）/ local=本地子进程（仅开发）/ auto=自动检测（默认）
SANDBOX_MODE=auto
# 判题镜像与资源限额（一般无需修改；镜像不存在时会用 docker/Dockerfile.judge 自动构建）
JUDGE_IMAGE=interview-judge:latest
JUDGE_MEM=128m
JUDGE_CPUS=0.5

# ===== 云端语音（ASR + TTS）配置 =====
# 供应商：aliyun=阿里百炼 / volcengine=火山引擎 / mock=本地调试
# 留空=自动选择（优先阿里，其次火山；都没配则语音模式回退浏览器原生语音）
VOICE_PROVIDER=

# --- 阿里百炼（需安装 dashscope：uv pip install dashscope）---
# 开通：https://bailian.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=
ALIYUN_ASR_MODEL=paraformer-realtime-v2
ALIYUN_TTS_MODEL=cosyvoice-v2
ALIYUN_TTS_VOICE=longxiaochun_v2

# --- 火山引擎（纯 WebSocket，无需 SDK）---
# 开通：火山引擎控制台「语音技术」→ 流式语音识别大模型 + 语音合成大模型
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
# 豆包语音合成大模型音色（面试官气质男声示例，可在控制台音色列表更换）
VOLC_TTS_VOICE=zh_male_jingqiangkanye_moon_bigtts
VOLC_TTS_RATE=24000
VOLC_ASR_RESOURCE=volc.bigasr.sauc.duration
